# Official Discord Bot token, never a Discord user token
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_application_id_here
# Set 0 if Message Content Intent is not enabled in Developer Portal
DISCORD_MESSAGE_CONTENT_INTENT=0

# Choose codex or cursor. This example selects codex; unset defaults to cursor.
AI_PROVIDER=codex

# Codex only (AI_PROVIDER=codex): install the CLI and choose login or API key.
# Use a dedicated account/CODEX_HOME with no unrelated plugins, MCP or secrets.
CODEX_BIN=codex
# DISCORD_CODEX_HOME=/var/lib/discord-translate/codex
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_MS=120000
CODEX_MAX_CONCURRENCY=2
# Optional alternative to an existing Codex login; never commit a real key.
# CODEX_API_KEY=

# Cursor only: set AI_PROVIDER=cursor above and uncomment CURSOR_API_KEY.
# Codex settings are ignored in Cursor mode.
# CURSOR_API_KEY=your_cursor_api_key_here
# CURSOR_MODEL=composer-2.5
